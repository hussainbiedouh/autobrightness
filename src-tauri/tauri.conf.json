{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AutoBrightness",
  "version": "0.1.0",
  "identifier": "com.local.autobrightness",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "AutoBrightness",
        "width": 440,
        "height": 700,
        "resizable": false,
        "decorations": false,
        "transparent": false,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
